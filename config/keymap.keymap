#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none      &none     &none     &none                 &none                                   &none      &none  &none      &none    &none        &none
&none  &kp Q      &kp W     &kp E     &kp R                 &kp T                                   &kp Y      &kp U  &kp I      &kp O    &kp P        &none
&none  &kp A      &kp S     &kp D     &kp F                 &kp G        &none          &none       &kp H      &kp J  &kp K      &kp L    &kp MINUS    &none
&none  &kp Z      &kp X     &kp C     &kp V                 &kp B        &kp BACKSPACE  &kp DELETE  &kp N      &kp M  &kp COMMA  &kp DOT  &lt 4 PIPE   &none
&none  &kp LCTRL  &kp LGUI  &kp LALT  &mt LEFT_SHIFT GRAVE  &lt 4 SPACE  &lt 3 ENTER    &lt 2 TAB   &lt 3 TAB  &none  &none      &none    &lt 5 RCTRL  &none
            >;
        };

        layer_1 {
            bindings = <
&none  &none         &none            &none             &none                 &none                            &none                  &none                 &none      &none                &none                    &none
&none  &none         &kp LS(N7)       &kp ASTERISK      &kp LEFT_PARENTHESIS  &none                            &kp ASTERISK           &kp LEFT_PARENTHESIS  &none      &kp LS(GRAVE)        &none                    &none
&none  &none         &kp DOLLAR       &kp PERCENT       &kp AMPS              &none      &none          &none  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)     &none      &kp LEFT_BRACKET     &kp LS(INTERNATIONAL_1)  &none
&none  &kp QUESTION  &kp EXCLAMATION  &kp LS(NUMBER_2)  &kp HASH              &kp TILDE  &kp BACKSPACE  &none  &kp RIGHT_BRACKET      &kp BACKSLASH         &kp SLASH  &kp INTERNATIONAL_3  &none                    &none
&none  &none         &none            &none             &none                 &none      &none          &none  &none                  &none                 &none      &none                &none                    &none
            >;
        };

        layer_2 {
            bindings = <
&none  &none               &none         &none         &none               &none                               &none       &none   &none   &none   &none    &none
&none  &kp LS(APOSTROPHE)  &kp N7        &kp N8        &kp N9              &kp COLON                           &none       &kp F7  &kp F8  &kp N9  &kp F10  &none
&none  &kp SLASH           &kp NUMBER_4  &kp N5        &kp NUMBER_6        &kp MINUS     &none          &none  &none       &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &kp PERCENT         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3        &kp PERIOD    &kp LS(MINUS)  &none  &kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F12  &none
&none  &kp APOSTROPHE      &kp N0        &kp PLUS      &kp LS(LANGUAGE_5)  &kp LC(SEMI)  &none          &none  &none       &none   &none   &none   &none    &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &none  &none  &none  &none                        &none     &none           &none           &none      &none    &none
&none  &none  &none  &none  &none  &none                        &none     &kp TAB         &kp UP_ARROW    &kp TAB    &none    &none
&none  &none  &none  &none  &none  &none  &none          &none  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp END  &none
&none  &none  &none  &none  &none  &none  &kp BACKSPACE  &none  &none     &none           &none           &none      &none    &none
&none  &none  &none  &none  &none  &none  &none          &none  &none     &none           &none           &none      &none    &none
            >;
        };

        layer_4 {
            bindings = <
&none  &none      &none      &none      &none           &none                        &none      &none               &none                   &none     &none            &none
&none  &none      &none      &mkp MB4   &mkp MB5        &none                        &kp LC(Y)  &kp LC(UP_ARROW)    &kp LS(LC(UP_ARROW))    &none     &kp PRINTSCREEN  &none
&none  &kp LC(Y)  &kp LC(S)  &none      &kp LC(F)       &none  &none          &none  &none      &mkp MB1            &mkp MB3                &mkp MB2  &none            &none
&none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)       &none  &kp BACKSPACE  &none  &none      &kp LC(DOWN_ARROW)  &kp LS(LC(DOWN_ARROW))  &none     &none            &none
&none  &none      &none      &none      &kp LEFT_SHIFT  &none  &none          &none  &none      &none               &none                   &none     &bt BT_CLR_ALL   &none
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                              &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans      &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans      &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &bt BT_CLR  &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };
    };
};
