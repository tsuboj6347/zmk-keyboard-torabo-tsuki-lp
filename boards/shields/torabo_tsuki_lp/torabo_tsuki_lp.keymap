
#include "../../../config/keymap.keymap"

/* 【完全解決】左手（子機）から飛んでくるトラックパッドのデータを、右手（親機）側でキャッチして左右反転させる */
&i2c1 {
    iqs7211e@44 {
        reg = <0x44>;
    };
};

/* 左手（子機）から飛んでくる無線入力（スプリット）のリスナーを上書き */
&pointing_split_listener {
    /* 左手から受信したデータ全体の、左右（X軸）のみを反転させる */
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>;
};
